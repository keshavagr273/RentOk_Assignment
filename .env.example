# =============================================================================
# RentOk LLM Gateway — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.
# NEVER log any of these values or return them in API responses.
# =============================================================================

# ── Application ──────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── Database ──────────────────────────────────────────────────────────────────
# Local (Docker Compose): postgresql://postgres:postgres@localhost:5432/llm_gateway
# Production (Railway):   injected automatically if using Railway Postgres plugin
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/llm_gateway

# ── Redis ─────────────────────────────────────────────────────────────────────
# Local (Docker Compose): redis://localhost:6379
# Production (Railway):   injected automatically if using Railway Redis plugin
REDIS_URL=redis://localhost:6379

# ── Provider API Keys ─────────────────────────────────────────────────────────
# These are your REAL LLM provider keys. They never leave the server.
# They are NEVER forwarded to clients, logged, or returned in responses.
#
# Groq (primary): https://console.groq.com — generous free tier
GROQ_API_KEY=your_groq_api_key_here

# Google Gemini (fallback): https://aistudio.google.com — free tier available
GEMINI_API_KEY=your_gemini_api_key_here

# ── Provider Configuration ────────────────────────────────────────────────────
PROVIDER_PRIMARY=groq
PROVIDER_FALLBACK=gemini

# Timeout for provider calls in milliseconds
# After this, one retry on primary, then switch to fallback
PROVIDER_TIMEOUT_MS=8000

# ── Budget Enforcement ────────────────────────────────────────────────────────
# Default budget type when creating keys (requests | tokens | cost_inr)
DEFAULT_BUDGET_TYPE=requests

# ── Semantic Cache (Stretch Goal) ─────────────────────────────────────────────
# Set to false to disable the semantic cache entirely
CACHE_ENABLED=true

# Cosine similarity threshold for cache hits (0.0–1.0)
# Higher = more conservative (fewer hits, less risk of wrong cached answer)
# Lower = more aggressive (more hits, higher risk of mismatched intent)
# Default: 0.95 — conservative starting point without a labeled evaluation set
CACHE_SIMILARITY_THRESHOLD=0.95

# If true: cache hits still increment the budget counter at a reduced rate
# If false: cache hits are "free" (no budget impact)
# Implement both and compare in DECISIONS.md
CACHE_CHARGE_ON_HIT=false

# Reduced budget multiplier when CACHE_CHARGE_ON_HIT=true (0.0–1.0)
# e.g., 0.1 means cache hits cost 10% of a normal request
CACHE_HIT_COST_MULTIPLIER=0.1

# Embedding model for semantic cache
# Must match the vector dimensions in the prompt_cache table (default: 1536)
EMBEDDING_MODEL=text-embedding-ada-002

# ── Security ──────────────────────────────────────────────────────────────────
# Salt rounds for any bcrypt operations (if used)
# For SHA-256 key hashing, no salt configuration needed
BCRYPT_ROUNDS=10

# ── Logging ───────────────────────────────────────────────────────────────────
# Log level: error | warn | log | debug | verbose
LOG_LEVEL=log

# Set to true to log provider request/response bodies (for debugging only)
# NEVER set to true in production — responses may contain PII
LOG_PROVIDER_BODIES=false
