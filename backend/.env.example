# =============================================================================
# RentOk LLM Gateway — Backend Environment Variables
# Copy to .env and fill in real values. NEVER commit .env.
# =============================================================================

# ── App ───────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# CORS: comma-separated allowed origins (frontend URLs)
CORS_ORIGIN=http://localhost:3001

# ── Database ──────────────────────────────────────────────────────────────────
# Local (Docker Compose):
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/llm_gateway

# ── Redis ─────────────────────────────────────────────────────────────────────
# Local (Docker Compose):
REDIS_URL=redis://localhost:6379

# ── Provider API Keys — NEVER log, NEVER return in responses ─────────────────
# Groq (primary): https://console.groq.com — generous free tier
GROQ_API_KEY=your_groq_api_key_here

# Google Gemini (fallback): https://aistudio.google.com — free tier
GEMINI_API_KEY=your_gemini_api_key_here

# ── Provider Configuration ────────────────────────────────────────────────────
# Timeout for each provider call in milliseconds
PROVIDER_TIMEOUT_MS=8000

# Default models (overridable per-request via the model field in body)
GROQ_DEFAULT_MODEL=llama3-8b-8192
GEMINI_DEFAULT_MODEL=gemini-1.5-flash

# ── Semantic Cache (Stretch Goal) ─────────────────────────────────────────────
# Set to false to disable the semantic cache entirely
CACHE_ENABLED=false

# Cosine similarity threshold (0.0–1.0). Higher = more conservative.
# 0.95 chosen as conservative default (see DECISIONS.md Section 8)
CACHE_SIMILARITY_THRESHOLD=0.95

# If true, cache hits still increment budget by CACHE_HIT_COST_MULTIPLIER fraction
CACHE_CHARGE_ON_HIT=false
CACHE_HIT_COST_MULTIPLIER=0.1

# Embedding endpoint — defaults to OpenAI, works with any OpenAI-compatible API
# Leave EMBEDDING_API_KEY empty to disable cache (cache will not be used)
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small

# ── Cost Estimation (INR per 1M tokens) ──────────────────────────────────────
# Used to estimate cost_estimate_inr in usage logs
# Default: Groq llama3-8b at ~84 USD/INR conversion
USD_TO_INR=84

# ── Administrative Security ───────────────────────────────────────────────────
# Static bearer token protecting /admin/keys (GET and POST)
# Callers use Authorization: Bearer <ADMIN_TOKEN>
ADMIN_TOKEN=your_secure_admin_token_here
